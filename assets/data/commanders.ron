// Paw & Claw - Commander Definitions
//
// Every Advance Wars 2 / Dual Strike CO has a woodland counterpart with the
// same abilities (`based_on` names it). Each commander has:
//   abilities    - always on (AW "day to day")
//   power        - CO Power: stars, extra modifiers while it runs, instant effects
//   super_power  - Super CO Power, likewise
// While either power runs, every unit also gets +10 attack and +10 defense.
//
// Modifiers (all optional), in AW percentage points:
//   attack / defense / movement / range / vision: [(UnitFilter, amount)]
//     UnitFilter: All, Direct, DirectNonFoot, Indirect, Foot, NonFoot, Vehicles,
//                 Ground, Air, Naval, Transports, Units([Skywing, ...])
//   attack_on: [(Plains | Roads | Properties, amount)]
//   attack_per_terrain_star, terrain_stars (100 = doubled), capture, cost,
//   luck (extra good luck, AW base 0-9), bad_luck, counter, income (per property),
//   daily_stamina: [(UnitFilter, change)], weather_proof: [Snow, Rain, ...],
//   flat_terrain_cost, hidden_hp, see_hidden, counter_first, funds_from_damage,
//   defense_vs_indirect, build_on_cities, repair
// Effects: Heal(hp), DamageEnemies(hp), DamageEnemiesOnProperties(hp),
//   HalveEnemyStamina, Weather(kind), MultiplyFunds(x), DrainEnemyPower(% per 5000),
//   AttackPerFunds(% per 1000), AttackPerProperty(%), Resupply, ExtraMove(filter),
//   Reinforce(unit, hp), Meteor(damage, radius, strikes, paralyze)

(
    commanders: {
        // ========== WESTERN FRONTIER (Orange Star) ==========
        "dusty": (
            name: "Dusty",
            faction: Western,
            personality: Methodical,
            description: "A raccoon tinkerer who can patch up anything with twine and pluck. No strengths, no weaknesses.",
            based_on: "Andy",
            power: Some((
                name: "Patch Job",
                description: "All units recover 2 HP.",
                stars: 3,
                effects: [Heal(2)],
            )),
            super_power: (
                name: "Full Overhaul",
                description: "All units recover 5 HP, gain +10% attack and +1 movement.",
                stars: 6,
                modifiers: (attack: [(All, 10)], movement: [(All, 1)]),
                effects: [Heal(5)],
            ),
        ),
        "talon_co": (
            name: "Talon",
            faction: Western,
            personality: Aggressive,
            description: "A hawk who swoops straight in. Direct combat units are strong; indirect ones weak and short-ranged.",
            based_on: "Max",
            abilities: (
                attack: [(DirectNonFoot, 20), (Indirect, -10)],
                range: [(Indirect, -1)],
            ),
            power: Some((
                name: "Dive",
                description: "Direct combat units gain +10% attack and +1 movement.",
                stars: 3,
                modifiers: (attack: [(DirectNonFoot, 10)], movement: [(DirectNonFoot, 1)]),
            )),
            super_power: (
                name: "Talon Strike",
                description: "Direct combat units gain +30% attack and +2 movement.",
                stars: 6,
                modifiers: (attack: [(DirectNonFoot, 30)], movement: [(DirectNonFoot, 2)]),
            ),
        ),
        "bandit": (
            name: "Bandit",
            faction: Western,
            personality: Reckless,
            description: "A raccoon scout who lives off the land. Foot soldiers fight and capture well, transports move further; other direct units are weaker.",
            based_on: "Sami",
            abilities: (
                attack: [(Foot, 20), (DirectNonFoot, -10)],
                movement: [(Transports, 1)],
                capture: 50,
            ),
            power: Some((
                name: "Quick March",
                description: "Foot soldiers gain +1 movement and +10% attack.",
                stars: 3,
                modifiers: (attack: [(Foot, 10)], movement: [(Foot, 1)]),
            )),
            super_power: (
                name: "Midnight Raid",
                description: "Foot soldiers gain +2 movement, +30% attack, and capture in a single turn.",
                stars: 8,
                modifiers: (attack: [(Foot, 30)], movement: [(Foot, 2)], capture: 1000),
            ),
        ),
        "clover": (
            name: "Clover",
            faction: Western,
            personality: Aggressive,
            description: "An opossum captain blessed with uncanny luck. Her attacks can deal surprising damage.",
            based_on: "Nell",
            abilities: (luck: 10),
            power: Some((
                name: "Four-Leaf",
                description: "Luck rises sharply: attacks can deal far more damage.",
                stars: 3,
                modifiers: (luck: 40),
            )),
            super_power: (
                name: "Fortune's Favour",
                description: "Luck soars: attacks can deal massive damage.",
                stars: 6,
                modifiers: (luck: 90),
            ),
        ),
        "shell": (
            name: "Shell",
            faction: Western,
            personality: Methodical,
            description: "An old armadillo trader who knows every supplier in the woods. Units cost 10% less.",
            based_on: "Hachi",
            abilities: (cost: -10),
            power: Some((
                name: "Haggle",
                description: "Units cost half price.",
                stars: 3,
                modifiers: (cost: -40),
            )),
            super_power: (
                name: "Trading Post",
                description: "Units cost half price and can be mustered at storehouses.",
                stars: 5,
                modifiers: (cost: -40, build_on_cities: true),
            ),
        ),
        "ridge": (
            name: "Ridge",
            faction: Western,
            personality: Aggressive,
            description: "A young coyote who loves open country. Units fight better on grass.",
            based_on: "Jake",
            abilities: (attack_on: [(Plains, 10)]),
            power: Some((
                name: "Stampede",
                description: "Units on grass gain +10% attack; ground siege engines gain +1 range.",
                stars: 3,
                modifiers: (attack_on: [(Plains, 10)], range: [(Units([Siege, Barrage, Stinger]), 1)]),
            )),
            super_power: (
                name: "Open Range",
                description: "Units on grass gain +30% attack; vehicles gain +2 movement.",
                stars: 6,
                modifiers: (attack_on: [(Plains, 30)], movement: [(Vehicles, 2)]),
            ),
        ),
        "hollis": (
            name: "Hollis",
            faction: Western,
            personality: Cautious,
            description: "A hawk medic who keeps her troops in the fight. Units repair 1 extra HP on properties.",
            based_on: "Rachel",
            abilities: (repair: 1),
            power: Some((
                name: "Second Wind",
                description: "Luck rises: attacks can deal more damage.",
                stars: 3,
