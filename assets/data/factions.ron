// Paw & Claw - Faction Definitions
// Modify this file to customize faction names, colors, and properties
//
// Factions are cosmetic: name, color, animals and sprites. Colors follow
// their Advance Wars counterparts: Western = Orange Star, Northern = Blue Moon,
// Southern = Green Earth, Eastern = Yellow Comet, Nether = Black Hole. As in Advance Wars,
// every gameplay effect (prices, stats, powers) comes from the commander
// (commanders.ron).

(
    factions: {
        "eastern": (
            name: "Eastern Empire",
            description: "Disciplined armies of the rising sun. Strength in numbers.",
            color: (0.95, 0.8, 0.15),
            animals: ["Tanuki", "Red Panda", "Crane", "Kitsune", "Macaque"],
            asset_folder: "eastern",
        ),
        "northern": (
            name: "Northern Realm",
            description: "Stalwart defenders of the ancient forests. Unbreakable lines.",
            color: (0.3, 0.5, 0.9),
            animals: ["Badger", "Hedgehog", "Stoat", "Owl", "Fox"],
            asset_folder: "northern",
        ),
        "western": (
            name: "Western Frontier",
            description: "Cunning survivalists of the wild frontier. Strike and fade.",
            color: (0.92, 0.33, 0.12),
            animals: ["Raccoon", "Opossum", "Coyote", "Hawk", "Armadillo"],
            asset_folder: "western",
        ),
        "southern": (
            name: "Southern Pride",
            description: "Mighty beasts of the savanna. Power and endurance.",
            color: (0.3, 0.7, 0.3),
            animals: ["Lion", "Elephant", "Rhino", "Hyena", "Cheetah"],
            asset_folder: "southern",
        ),
        "nether": (
            name: "Nether Dominion",
            description: "Relentless burrowers from below. They emerge without warning.",
            color: (0.3, 0.22, 0.36),
            animals: ["Mole", "Anteater", "Skunk", "Shrew", "Pangolin"],
            asset_folder: "nether",
        ),
    }
)
